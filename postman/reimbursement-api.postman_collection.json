    {
      "name": "Reimbursements",
      "item": [
        {
          "name": "List Reimbursements",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reimbursements?page=1&limit=10&sortBy=createdAt&sortOrder=desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reimbursements"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "sortBy",
                  "value": "createdAt",
                  "description": "createdAt, expenseDate ou amount"
                },
                {
                  "key": "sortOrder",
                  "value": "desc",
                  "description": "asc ou desc"
                },
                {
                  "key": "status",
                  "value": "",
                  "description": "Opcional: DRAFT, SUBMITTED, APPROVED, REJECTED, PAID ou CANCELED",
                  "disabled": true
                },
                {
                  "key": "categoryId",
                  "value": "",
                  "description": "Opcional",
                  "disabled": true
                },
                {
                  "key": "collaboratorId",
                  "value": "",
                  "description": "Opcional para ADMIN, MANAGER e FINANCE",
                  "disabled": true
                }
              ]
            },
            "description": "Rota protegida. ADMIN vê todos, COLLABORATOR vê próprios, MANAGER vê SUBMITTED/APPROVED/REJECTED e FINANCE vê APPROVED/PAID."
          }
        },
        {
          "name": "Create Reimbursement",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.environment.set('reimbursementId', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 125.5,\n  \"categoryId\": \"{{categoryId}}\",\n  \"description\": \"Táxi para reunião com cliente\",\n  \"expenseDate\": \"2026-05-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/reimbursements",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reimbursements"
              ]
            },
            "description": "Rota protegida. Requer COLLABORATOR. Cria solicitação com status DRAFT e histórico CREATED."
          }
        },
        {
          "name": "Get Reimbursement By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reimbursements/{{reimbursementId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reimbursements",
                "{{reimbursementId}}"
              ]
            },
            "description": "Rota protegida. O acesso depende da role e da visibilidade da solicitação."
          }
        },
        {
          "name": "Update Reimbursement",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 150,\n  \"categoryId\": \"{{categoryId}}\",\n  \"description\": \"Táxi para reunião com cliente - atualizado\",\n  \"expenseDate\": \"2026-05-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/reimbursements/{{reimbursementId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reimbursements",
                "{{reimbursementId}}"
              ]
            },
            "description": "Rota protegida. Requer COLLABORATOR. Somente o dono pode editar uma solicitação DRAFT. Gera histórico UPDATED."
          }
        },
        {
          "name": "Submit Reimbursement",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reimbursements/{{reimbursementId}}/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reimbursements",
                "{{reimbursementId}}",
                "submit"
              ]
            },
            "description": "Rota protegida. Requer COLLABORATOR. Transição DRAFT -> SUBMITTED e histórico SUBMITTED."
          }
        },
        {
          "name": "Cancel Reimbursement",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reimbursements/{{reimbursementId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reimbursements",
                "{{reimbursementId}}",
                "cancel"
              ]
            },
            "description": "Rota protegida. Requer COLLABORATOR. Transição DRAFT -> CANCELED e histórico CANCELED."
          }
        },
        {
          "name": "Approve Reimbursement",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reimbursements/{{reimbursementId}}/approve",
              "host": [
                "{{baseUrl}}"
