                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/reimbursements/{{reimbursementId}}/reject",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reimbursements",
                "{{reimbursementId}}",
                "reject"
              ]
            },
            "description": "Rota protegida. Requer MANAGER. Transição SUBMITTED -> REJECTED, justificativa obrigatória e histórico REJECTED."
