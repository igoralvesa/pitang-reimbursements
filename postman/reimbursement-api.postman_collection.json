            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Usuario Atualizado\",\n  \"email\": \"usuario.atualizado@email.com\",\n  \"password\": \"NovaSenha@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            },
            "description": "Protected route. Requires ADMIN."
          }
        },
        {
          "name": "Promote User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"MANAGER\"\n}",
              "options": {
